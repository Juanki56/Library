# Copia este archivo como .env.local y rellena los valores. Nunca subas .env.local al repositorio.
# Los valores están en Supabase > Project Settings > API Keys (y Data API para la URL).

# URL del proyecto. Es pública: puede llegar al navegador.
NEXT_PUBLIC_SUPABASE_URL="https://[REF].supabase.co"
# Clave publicable (sb_publishable_... o la antigua "anon"). Es pública; RLS protege los datos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Clave secreta (sb_secret_... o la antigua "service_role"). SOLO para las pruebas automáticas
# (crear y borrar usuarios de prueba). Salta RLS: nunca la uses en código de la aplicación.
SUPABASE_SECRET_KEY=""
